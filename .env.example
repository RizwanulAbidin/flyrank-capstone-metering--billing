# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Postgres. When running under Docker Compose the host is `db`, not `localhost`.
DATABASE_URL=postgres://postgres:dev@localhost:5432/metering

# HTTP server
PORT=3000

# Stripe TEST MODE ONLY. Keys starting sk_live_ must never appear here.
# Project Settings -> Developers -> API keys (test mode).
STRIPE_SECRET_KEY=sk_test_replace_me

# Printed by `stripe listen --forward-to localhost:3000/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# The Stripe Price id for the Pro plan (test mode).
STRIPE_PRICE_ID_PRO=price_replace_me
